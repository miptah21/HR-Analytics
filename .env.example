# ── HR Analytics — Environment Variables ───────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual .env file to version control.

# Runtime Mode (set to "production" in production to enforce API key)
ENV=development

# ── LLM API Keys (fallback chain: Gemini → Gemini_2 → Groq → Groq_2 → Groq_3)
# The system will try each key in order. If one fails (rate limit, auth error),
# it automatically falls back to the next. You only need ONE key to work.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_2=your-gemini-backup-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=your-groq-backup-key-here
GROQ_API_KEY_3=your-groq-backup-2-key-here

# API Security (REQUIRED in production — leave empty for dev bypass)
API_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# RBAC Configuration (optional — if set, overrides API_SECRET_KEY for per-key roles)
# Format: JSON object mapping API keys to roles.
# Roles and Dashboard Access:
#   admin       → Full Access (all tabs: Overview, Analytics, Drift Monitor, Decision Cockpit, AI Ethics, Audit Trail)
#   hr_partner  → HR Operations (Overview, Analytics, Decision Cockpit, AI Ethics, Audit Trail)
#   analyst     → Analytics & Reports (Overview, Analytics, AI Ethics, Audit Trail)
#   auditor     → Compliance Audit (Audit Trail only)
# Example: RBAC_KEYS={"sk-admin-xxx":"admin","sk-hr-yyy":"hr_partner","sk-analyst-zzz":"analyst"}
RBAC_KEYS=

# Database Configuration (used by Docker Compose, DLT, GE, and Airflow DAG)
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=hr_analytics
DATABASE_URL=postgresql://hr_admin:change-me-in-production@localhost:5432/hr_analytics

# dbt Configuration (used by profiles.yml via env_var())
DBT_HOST=host.docker.internal
DBT_PORT=5432
